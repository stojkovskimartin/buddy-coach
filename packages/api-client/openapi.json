{
  "components": {
    "schemas": {
      "AgentName": {
        "description": "All agents in the network.",
        "enum": [
          "head_coach",
          "nutrition",
          "training",
          "recovery",
          "progress",
          "motivation"
        ],
        "title": "AgentName",
        "type": "string"
      },
      "ChatReply": {
        "description": "The coach's answer.",
        "properties": {
          "agent": {
            "$ref": "#/components/schemas/AgentName"
          },
          "degraded": {
            "description": "True when the AI was unavailable and a fallback was used",
            "title": "Degraded",
            "type": "boolean"
          },
          "escalated": {
            "title": "Escalated",
            "type": "boolean"
          },
          "reply": {
            "title": "Reply",
            "type": "string"
          },
          "safety_category": {
            "$ref": "#/components/schemas/SafetyCategory"
          },
          "tools_used": {
            "items": {
              "type": "string"
            },
            "title": "Tools Used",
            "type": "array"
          }
        },
        "required": [
          "reply",
          "agent",
          "tools_used",
          "escalated",
          "safety_category",
          "degraded"
        ],
        "title": "ChatReply",
        "type": "object"
      },
      "ChatRequest": {
        "description": "A message to the coach.",
        "properties": {
          "message": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "CoachStyle": {
        "description": "How the coach talks to the user.",
        "enum": [
          "friendly",
          "strict",
          "data_driven"
        ],
        "title": "CoachStyle",
        "type": "string"
      },
      "ExperienceLevel": {
        "description": "Training experience.",
        "enum": [
          "beginner",
          "intermediate",
          "advanced",
          "elite"
        ],
        "title": "ExperienceLevel",
        "type": "string"
      },
      "GoalIn": {
        "description": "Create a goal.",
        "properties": {
          "event_distance_km": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 10000.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Distance Km"
          },
          "goal_type": {
            "$ref": "#/components/schemas/GoalType"
          },
          "priority": {
            "$ref": "#/components/schemas/GoalPriority",
            "default": "primary"
          },
          "sport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sport"
              },
              {
                "type": "null"
              }
            ]
          },
          "target_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          },
          "target_weight_kg": {
            "anyOf": [
              {
                "maximum": 300.0,
                "minimum": 30.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Weight Kg"
          },
          "title": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "goal_type",
          "title"
        ],
        "title": "GoalIn",
        "type": "object"
      },
      "GoalOut": {
        "description": "A stored goal.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "event_distance_km": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Distance Km"
          },
          "goal_type": {
            "$ref": "#/components/schemas/GoalType"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "priority": {
            "$ref": "#/components/schemas/GoalPriority"
          },
          "sport": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Sport"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "$ref": "#/components/schemas/GoalStatus"
          },
          "target_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Date"
          },
          "target_weight_kg": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Target Weight Kg"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "id",
          "goal_type",
          "title",
          "sport",
          "target_weight_kg",
          "event_distance_km",
          "target_date",
          "priority",
          "status",
          "created_at"
        ],
        "title": "GoalOut",
        "type": "object"
      },
      "GoalPriority": {
        "description": "A user has at most one active primary goal.",
        "enum": [
          "primary",
          "secondary"
        ],
        "title": "GoalPriority",
        "type": "string"
      },
      "GoalStatus": {
        "description": "Lifecycle of a goal.",
        "enum": [
          "active",
          "achieved",
          "abandoned"
        ],
        "title": "GoalStatus",
        "type": "string"
      },
      "GoalStatusUpdate": {
        "description": "Change a goal's status.",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/GoalStatus"
          }
        },
        "required": [
          "status"
        ],
        "title": "GoalStatusUpdate",
        "type": "object"
      },
      "GoalType": {
        "description": "What the user wants to achieve.",
        "enum": [
          "lose_weight",
          "gain_weight",
          "maintain_weight",
          "recomposition",
          "endurance_event",
          "mountain_sport",
          "strength",
          "general_fitness"
        ],
        "title": "GoalType",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Exchange credentials for tokens.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "ProfileIn": {
        "description": "Create or replace the profile.",
        "properties": {
          "available_days_per_week": {
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Available Days Per Week",
            "type": "integer"
          },
          "birth_year": {
            "maximum": 2100.0,
            "minimum": 1920.0,
            "title": "Birth Year",
            "type": "integer"
          },
          "coach_style": {
            "$ref": "#/components/schemas/CoachStyle",
            "default": "friendly"
          },
          "experience": {
            "$ref": "#/components/schemas/ExperienceLevel"
          },
          "height_cm": {
            "maximum": 250.0,
            "minimum": 100.0,
            "title": "Height Cm",
            "type": "number"
          },
          "locale": {
            "default": "en",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Locale",
            "type": "string"
          },
          "minutes_per_session": {
            "maximum": 600.0,
            "minimum": 10.0,
            "title": "Minutes Per Session",
            "type": "integer"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "timezone": {
            "default": "Europe/Zurich",
            "title": "Timezone",
            "type": "string"
          },
          "weight_kg": {
            "maximum": 300.0,
            "minimum": 30.0,
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "birth_year",
          "sex",
          "height_cm",
          "weight_kg",
          "experience",
          "available_days_per_week",
          "minutes_per_session"
        ],
        "title": "ProfileIn",
        "type": "object"
      },
      "ProfileOut": {
        "description": "The stored profile.",
        "properties": {
          "available_days_per_week": {
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Available Days Per Week",
            "type": "integer"
          },
          "birth_year": {
            "maximum": 2100.0,
            "minimum": 1920.0,
            "title": "Birth Year",
            "type": "integer"
          },
          "coach_style": {
            "$ref": "#/components/schemas/CoachStyle",
            "default": "friendly"
          },
          "experience": {
            "$ref": "#/components/schemas/ExperienceLevel"
          },
          "height_cm": {
            "maximum": 250.0,
            "minimum": 100.0,
            "title": "Height Cm",
            "type": "number"
          },
          "locale": {
            "default": "en",
            "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
            "title": "Locale",
            "type": "string"
          },
          "minutes_per_session": {
            "maximum": 600.0,
            "minimum": 10.0,
            "title": "Minutes Per Session",
            "type": "integer"
          },
          "sex": {
            "$ref": "#/components/schemas/Sex"
          },
          "timezone": {
            "default": "Europe/Zurich",
            "title": "Timezone",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          },
          "weight_kg": {
            "maximum": 300.0,
            "minimum": 30.0,
            "title": "Weight Kg",
            "type": "number"
          }
        },
        "required": [
          "birth_year",
          "sex",
          "height_cm",
          "weight_kg",
          "experience",
          "available_days_per_week",
          "minutes_per_session",
          "user_id",
          "updated_at"
        ],
        "title": "ProfileOut",
        "type": "object"
      },
      "RefreshRequest": {
        "description": "Exchange a refresh token for a new token pair (the old one is revoked).",
        "properties": {
          "refresh_token": {
            "maxLength": 2048,
            "minLength": 1,
            "title": "Refresh Token",
            "type": "string"
          }
        },
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest",
        "type": "object"
      },
      "RegisterRequest": {
        "description": "Create an account.",
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 128,
            "minLength": 10,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "SafetyCategory": {
        "description": "Why a message was escalated.",
        "enum": [
          "none",
          "emergency",
          "mental_health",
          "eating_disorder",
          "injury",
          "unsafe_output"
        ],
        "title": "SafetyCategory",
        "type": "string"
      },
      "Sex": {
        "description": "Sex used for energy-expenditure equations.",
        "enum": [
          "male",
          "female"
        ],
        "title": "Sex",
        "type": "string"
      },
      "Sport": {
        "description": "Sports the coach can plan for.",
        "enum": [
          "running",
          "cycling",
          "swimming",
          "triathlon",
          "hiking",
          "ski_touring",
          "alpine_skiing",
          "climbing",
          "strength",
          "other"
        ],
        "title": "Sport",
        "type": "string"
      },
      "TokenPair": {
        "description": "Access and refresh tokens returned after login or refresh.",
        "properties": {
          "access_token": {
            "title": "Access Token",
            "type": "string"
          },
          "expires_in": {
            "description": "Access token lifetime in seconds",
            "title": "Expires In",
            "type": "integer"
          },
          "refresh_token": {
            "title": "Refresh Token",
            "type": "string"
          },
          "token_type": {
            "default": "bearer",
            "title": "Token Type",
            "type": "string"
          }
        },
        "required": [
          "access_token",
          "refresh_token",
          "expires_in"
        ],
        "title": "TokenPair",
        "type": "object"
      },
      "UserOut": {
        "description": "Account data safe to return to its owner.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "email",
          "is_active",
          "created_at"
        ],
        "title": "UserOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Buddy Coach API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "description": "Log in with email and password.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revoke a refresh token.",
        "operationId": "logout_api_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Logout",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "description": "Rotate the refresh token and get a new access token.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenPair"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Refresh",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "Create an account.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/coach/chat": {
      "post": {
        "description": "Send a message to the coach and get its answer.\n\nSingle-turn for now: conversation history is not yet stored or sent (see docs/backlog.md).",
        "operationId": "chat_api_v1_coach_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Chat",
        "tags": [
          "coach"
        ]
      }
    },
    "/api/v1/goals": {
      "get": {
        "description": "List the caller's goals, newest first.",
        "operationId": "list_goals_api_v1_goals_get",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/GoalStatus"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/GoalOut"
                  },
                  "title": "Response List Goals Api V1 Goals Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Goals",
        "tags": [
          "profile",
          "goals"
        ]
      },
      "post": {
        "description": "Create a goal.",
        "operationId": "create_goal_api_v1_goals_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Create Goal",
        "tags": [
          "profile",
          "goals"
        ]
      }
    },
    "/api/v1/goals/{goal_id}": {
      "patch": {
        "description": "Change a goal's status.",
        "operationId": "update_goal_status_api_v1_goals__goal_id__patch",
        "parameters": [
          {
            "in": "path",
            "name": "goal_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Goal Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GoalStatusUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Update Goal Status",
        "tags": [
          "profile",
          "goals"
        ]
      }
    },
    "/api/v1/profile": {
      "get": {
        "description": "Return the caller's profile.",
