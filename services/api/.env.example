BUDDY_ENVIRONMENT=development
# The Docker database (infra/docker-compose.yml) listens on 5433.
BUDDY_DATABASE_URL=postgresql+asyncpg://buddy:buddy@localhost:5433/buddy
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
BUDDY_JWT_SECRET=change-me-to-a-long-random-secret-of-at-least-32-chars
# Allowed web origins, comma-separated
BUDDY_CORS_ORIGINS=http://localhost:5173
BUDDY_LOG_LEVEL=INFO
# Coach LLM: 'dev' (no key, local only), 'openai_compatible' (free: Ollama, Groq, Gemini)
# or 'anthropic'. Examples in docs/running.md, "Real AI answers".
BUDDY_LLM_PROVIDER=dev
# BUDDY_LLM_BASE_URL=http://localhost:11434/v1
# BUDDY_LLM_MODEL=qwen3:8b
# BUDDY_LLM_API_KEY=
# BUDDY_ANTHROPIC_API_KEY=
# Photos (meal, progress, profile) on local disk; meal photos are removed after this many days.
BUDDY_MEDIA_DIR=./media
BUDDY_MEAL_PHOTO_RETENTION_DAYS=90
# Direct accounts (docs/running.md, "Connect a Withings account"). The key encrypts their tokens:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BUDDY_INTEGRATIONS_KEY=
# BUDDY_WITHINGS_CLIENT_ID=
# BUDDY_WITHINGS_CLIENT_SECRET=
