{
  "name": "buddy-coach",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "api:export": "cd services/api && uv run python scripts/export_openapi.py ../../packages/api-client/openapi.json",
    "api:generate": "pnpm api:export && pnpm --filter @buddy/api-client generate"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0"
  }
}
